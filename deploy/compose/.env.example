# Settings for deploy/compose/compose.yml. deploy/setup.sh writes the real
# .env next to this file (mode 600, gitignored) and generates every secret;
# you only choose the settings in the first two blocks. Never commit .env,
# never paste it anywhere: it holds the database passwords, the key that
# signs every session and the key that encrypts every variable.

# Where people and agents reach this instance (https in production).
PUBLIC_URL=https://app.example.com
MCP_RESOURCE=https://mcp.example.com/mcp
# Optional: the public site (landing page, docs) on a hostname of its own.
SITE_URL=

# Email: sign-in codes go out through your SMTP server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=reliquary@example.com
SMTP_SENDER_NAME=Reliquary

# Optional: vault invites emailed by the web app through Resend
# (https://resend.com). Both, or neither (then owners copy invite links).
# RESEND_API_KEY: a key with sending access only; put it in with an editor.
# EMAIL_FROM: a sender on a domain verified in Resend,
# e.g. Reliquary <no-reply@notify.example.com>
RESEND_API_KEY=
EMAIL_FROM=
# Optional, with the two above: your address, to be emailed about each
# piece of feedback people send (scripts/feedback.sh reads it all anyway).
FEEDBACK_EMAIL=

# HTTPS with the caddy profile: the hostnames (deploy/setup.sh fills them
# from the URLs above when they are empty) and the address Let's Encrypt may
# write to. TRUST_PROXY_IP=1 only behind a proxy that overwrites X-Real-IP,
# as the bundled Caddyfile does.
APP_HOST=
MCP_HOST=
SITE_HOST=
ACME_EMAIL=
TRUST_PROXY_IP=0

# Where the apps listen on this machine (for your own proxy, or a trial).
WEB_BIND=127.0.0.1:8790
MCP_BIND=127.0.0.1:8787

# Generated by deploy/setup.sh: leave empty here.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
WEB_DB_PASSWORD=
MCP_DB_PASSWORD=
GOTRUE_JWT_SECRET=
GOTRUE_JWT_KEYS=
SESSION_SECRET=
VARIABLES_KEYS=
