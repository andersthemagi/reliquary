# Hosted configuration: what each Netlify site (web, mcp) reads. Shapes
# only, no values. Import them into the site's environment variables (Site
# configuration > Environment variables > Import from a .env file, "Contains
# secret values" on). scripts/netlify-env.sh writes the real ones into
# a gitignored file and prints only the names; docs/ops/runbook.md ("Hosts",
# "Rotating secrets") is the procedure. Self-hosting with Docker Compose reads
# deploy/compose/.env.example instead; local development needs none of this
# (./mcp/dev.sh sets its own).
#
# A variable marked "required" makes the app refuse to start on Netlify,
# naming the variable, when it is missing. Netlify publishes a deploy the
# moment it is uploaded, so a missing one is a down site: add a new required
# variable to Netlify before the release that needs it (the 2026-09-28 incident,
# docs/ops/runbook.md, "Rules that came from incidents"), and to this file in
# the same change.

# ---- web (Netlify site reliquary-web, built from web/) ---------------------

# Required, secret. The web app's role through the Supabase pooler.
DATABASE_URL=postgres://reliquary_web.<project-ref>:<password>@<pooler-host>:6543/postgres
# Required on Netlify. Sets TLS, so DATABASE_URL carries no sslmode. The file
# ships with the function (netlify.toml, included_files).
DATABASE_CA_FILE=supabase-ca.crt
# Optional. Connections per instance (web 3, mcp 5 by default).
# DB_POOL_MAX=3

# Required, https. The app's origin: sign-in, every signed-in page, the OAuth
# issuer, the environment API. Cookies and the POST Origin rule use it.
PUBLIC_URL=https://app.example.com
# Optional, https. The public site (landing, docs, legal pages) on
# its own origin. Its host serves only those and sets no cookies; the app host
# sends them there (308). Unset, one host serves both.
SITE_URL=https://example.com
# Required: the MCP endpoint's URL, byte for byte the mcp project's
# MCP_RESOURCE. The OAuth server issues tokens for this one resource.
MCP_RESOURCE=https://mcp.example.com/mcp
# The URL the Connect pages show people to add to their client. Set both to
# the same URL (the start check accepts either).
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# Required: sign-in through Supabase Auth.
AUTH_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The alg of the key in https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_ALG=ES256
# Required, secret. Generate with: head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
SESSION_SECRET=<32 random bytes, base64url>

# Required, secret, the web site ONLY (the mcp app refuses to start with
# either name). The keys that encrypt every environment variable and every
# link credential: id:key pairs, comma separated, the current key first, each
# key made like SESSION_SECRET. Keep a copy outside Netlify: without a key,
# every value sealed with it is lost. Never paste one into a chat. Rotation:
# docs/ops/runbook.md, "Rotating VARIABLES_KEY".
VARIABLES_KEYS=k1:<32 random bytes, base64url>
# Older single-key form of the same setting; use VARIABLES_KEYS.
# VARIABLES_KEY=<32 random bytes, base64url>
# VARIABLES_KEY_ID=k1

# Required, secret, the same value in both sites. How mcp/ authenticates
# its own calls to the web app's internal link-call endpoint. A mismatch
# refuses every proxied link call; rotate both and redeploy both together.
LINK_PROXY_SECRET=<24 random bytes, base64url>

# Optional: email the web app sends itself (vault invites), through Resend.
# Both or neither; without them owners copy the invite link. Sign-in email is
# Supabase Auth's own (docs/ops/runbook.md, "Email sender").
RESEND_API_KEY=re_...
EMAIL_FROM=Reliquary <no-reply@mail.example.com>
# Optional: where to email each piece of feedback people send. Unset, the
# hosted service falls back to its operator's contact address (web/src/site.ts).
# FEEDBACK_EMAIL=you@example.com

# ---- mcp (Netlify site reliquary-mcp, built from mcp/) ---------------------

# Required, secret. The MCP app's role: it never holds the web role.
# DATABASE_URL=postgres://reliquary_mcp.<project-ref>:<password>@<pooler-host>:6543/postgres
# DATABASE_CA_FILE=supabase-ca.crt
# DB_POOL_MAX=5
# Required, https: the same string as the web site's MCP_RESOURCE.
# MCP_RESOURCE=https://mcp.example.com/mcp
# Required: the web app's PUBLIC_URL, the OAuth issuer.
# AUTH_ISSUER=https://app.example.com
# Required, secret: the same value as the web site's.
# LINK_PROXY_SECRET=<24 random bytes, base64url>
# Optional, secret. When set, /healthz?db=1 needs an x-keepalive header
# with this value; the deploy workflow's GitHub secret of the same name sends it.
# KEEPALIVE_TOKEN=<random>

# ---- Never on Netlify -------------------------------------------------------

# In DATABASE_URL: sslmode or other TLS parameters (DATABASE_CA_FILE sets TLS;
# the server refuses both together). In either project: DATABASE_TLS,
# SELF_HOSTED, AUTH_URL, TRUST_PROXY_IP (self-hosting; Netlify's client address
# is trusted already), CIMD_ALLOW_LOOPBACK and LINK_DISCOVERY_ALLOW_LOOPBACK
# (tests only, refused on Netlify), RATE_LIMITS and RATE_LIMIT_SCALE (tests),
# LOCAL_USER_ID and LOGIN_FILE (the dev stand-in for sign-in), the Supabase
# secret key, the postgres password and SMTP credentials. OPS_DB_PASSWORD (the
# operator's role, for key rotation) lives in the operator's shell only.
