# Hosted configuration (docs/research/hosting.md, section 5). No values here:
# set them in each Vercel project (web, mcp) and mark every secret Sensitive.
# Local development needs none of this: ./mcp/dev.sh sets its own.

# web (Vercel project reliquary-web, Root Directory web)
DATABASE_URL=postgres://reliquary_web.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_CA_FILE=supabase-ca.crt
DB_POOL_MAX=3
PUBLIC_URL=https://app.example.com
MCP_PUBLIC_URL=https://mcp.example.com/mcp
# OAuth: the one resource the authorization server issues tokens for, byte
# for byte the mcp app's MCP_RESOURCE. PUBLIC_URL above is the issuer.
# Never set CIMD_ALLOW_LOOPBACK here (tests only; refused on Vercel).
MCP_RESOURCE=https://mcp.example.com/mcp
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SESSION_SECRET=<32 random bytes, base64url>

# mcp (Vercel project reliquary-mcp, Root Directory mcp)
# DATABASE_URL=postgres://reliquary_mcp.<project-ref>:<password>@<pooler-host>:6543/postgres
# DATABASE_CA_FILE=supabase-ca.crt
# DB_POOL_MAX=5
# MCP_RESOURCE=https://mcp.example.com/mcp   # required on Vercel; same string as the web app's
# AUTH_ISSUER=https://app.example.com        # required on Vercel; the web app's PUBLIC_URL
# KEEPALIVE_TOKEN=<random>

# Never in DATABASE_URL: sslmode or other TLS parameters (DATABASE_CA_FILE
# sets TLS; the server refuses both together, and refuses to start on Vercel
# without DATABASE_CA_FILE). Never on Vercel in milestone 1: the Supabase
# secret key, the postgres password, SMTP credentials.
