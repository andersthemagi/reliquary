[
  {
    "name": "changes_since",
    "title": "Changes since a cursor",
    "description": "A vault's events after a cursor, oldest first, with the text of proposal comments and review notes. Pass back the next cursor it returns.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "limit": {
          "description": "Events, default 100",
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "vault"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "comment_on_proposal",
    "title": "Comment on a proposal",
    "description": "Comment on a proposal's thread as your person. Words only: a comment can't approve, reject or change it (revise_proposal changes your own).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "proposal_id",
        "comment"
      ]
    },
    "annotations": null
  },
  {
    "name": "create_vault",
    "title": "Create a vault",
    "description": "Create a vault owned by your person (the log records you made it). Needs a token that reaches all your person's vaults read-write. default_policy: open (write directly) or canon (changes are proposals people approve). Only people set folder rules and members.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "The vault's name"
        },
        "default_policy": {
          "type": "string",
          "enum": [
            "open",
            "canon"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "annotations": null
  },
  {
    "name": "delete_file",
    "title": "Delete an open file",
    "description": "Delete an open file; its versions are kept and the deletion is logged. For a canon file, propose with delete: true.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "vault",
        "path"
      ]
    },
    "annotations": null
  },
  {
    "name": "list_files",
    "title": "List files",
    "description": "Files in a vault, one per line: path, [canon] if canon (the rest are open), last change.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "prefix": {
          "description": "Folder, e.g. 'clients/'",
          "type": "string",
          "maxLength": 1024
        },
        "after": {
          "description": "Path to continue after",
          "type": "string",
          "maxLength": 1024
        },
        "limit": {
          "description": "Default 200",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "vault"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "list_proposals",
    "title": "List proposals",
    "description": "A vault's proposals (open by default), newest first, with reviewers' notes. changes_requested: those waiting for you to revise.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "changes_requested",
            "applied",
            "rejected",
            "stale"
          ]
        }
      },
      "required": [
        "vault"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "list_variables",
    "title": "List environment variables",
    "description": "Names of a vault's environment variables per environment, and who last set each. Never values: you can't read, set or reveal one. Your person uses them with `reliquary run` or `reliquary env pull`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "environment": {
          "description": "e.g. development",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "vault"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "list_vaults",
    "title": "List vaults",
    "description": "Vaults this token reaches, with your role in each (viewer if the token is read-only). Other tools take a vault by name or id.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "propose",
    "title": "Propose a change",
    "description": "Propose writing or deleting a file, typically a canon one. People review it; it applies once enough approve. You cannot approve. Reviewers' notes arrive in changes_since; answer with revise_proposal.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "content": {
          "description": "Full new text; omit to delete",
          "type": "string",
          "maxLength": 1000000
        },
        "reason": {
          "type": "string",
          "maxLength": 4000,
          "description": "For the reviewers"
        },
        "delete": {
          "type": "boolean"
        }
      },
      "required": [
        "vault",
        "path",
        "reason"
      ]
    },
    "annotations": null
  },
  {
    "name": "read_file",
    "title": "Read a file",
    "description": "A file's text, policy and last writer. At most max_bytes (default 100000); from_line and to_line pick lines.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "from_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "to_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1048576
        }
      },
      "required": [
        "vault",
        "path"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "read_proposal",
    "title": "Read a proposal and its thread",
    "description": "One proposal: reason, proposed text, and its thread (comments, review notes, approvals), oldest first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        }
      },
      "required": [
        "proposal_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "revise_proposal",
    "title": "Revise a proposal",
    "description": "Replace your own proposal's text as a new revision; approvals of earlier revisions stop counting.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "content": {
          "type": "string",
          "maxLength": 1000000
        },
        "reason": {
          "description": "What changed",
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "proposal_id",
        "content"
      ]
    },
    "annotations": null
  },
  {
    "name": "search",
    "title": "Search a vault",
    "description": "Full-text search of a vault: \"phrases\", or, -exclusions. Up to 3 matching lines per file, best first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "limit": {
          "description": "Files, default 10",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "vault",
        "query"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "write_file",
    "title": "Write an open file",
    "description": "Create or replace a file whose policy is open. Canon files can't be written directly: use propose.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "content": {
          "type": "string",
          "maxLength": 1000000
        }
      },
      "required": [
        "vault",
        "path",
        "content"
      ]
    },
    "annotations": null
  }
]
